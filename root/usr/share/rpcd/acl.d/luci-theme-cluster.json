{
    "luci-theme-cluster": {
        "description": "cluster theme - temperature sensor, setting access, and services monitoring",
        "read": {
            "ubus": {
                "luci.cluster-temp": [
                    "getSensors",
                    "resetPeaks"
                ],
                "luci.cluster-system": [
                    "getSystemInfo"
                ],
                "luci.cluster-search-cache": [
                    "loadCache"
                ],
                "luci.cluster-settings": [
                    "getSettings"
                ],
                "network.interface": [
                    "dump"
                ],
                "luci-rpc": [
                    "getDHCPLeases"
                ]
            },
            "uci": [
                "cluster",
                "network",
                "wireless",
                "dhcp"
            ],
            "file": {
                "/etc/init.d/*": [
                    "exec"
                ],
                "/bin/pidof": [
                    "exec"
                ]
            }
        },
        "write": {
            "ubus": {
                "luci.cluster-settings": [
                    "setSetting",
                    "setSettings",
                    "resetSettings"
                ],
                "luci.cluster-search-cache": [
                    "saveCache",
                    "clearCache"
                ]
            },
            "uci": [
                "cluster"
            ]
        }
    }
}